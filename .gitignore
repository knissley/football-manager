# macOS
.DS_Store

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Package.resolved.backup

# Simulation harness output (regenerable)
/Tools/output/
*.simlog

# Secrets / local config
*.xcconfig.local
.env

# A local rulebook corpus for scripts/lint-reference.sh. The book is the copyrighted
# document CLAUDE.md rule 8 is about: the lint reads one from outside the tree, and this
# is here so a convenient local copy cannot be committed by accident.
/.rulebook.txt
/rulebook.pdf

# The two filenames scripts/fetch-rulebook.sh writes, unanchored. That script refuses to
# write inside a checkout, so this should never fire; it is here because "should never"
# and "cannot" are different, and the failure mode is committing a copyrighted document.
rulebook.pdf
rulebook.txt

# The three release assets scripts/fetch-calibration-data.sh writes, unanchored, for the
# same reason: that script refuses to write inside a checkout, and these are half a million
# rows about real players, which the tree carries only as derived aggregates (ADR-0005).
play_by_play_*.csv.gz
pbp_participation_*.csv
roster_weekly_*.csv

# Agent worktrees created by dispatch; each is its own checkout and never belongs in the tree.
.claude/worktrees/

# Python bytecode caches, from importing a script in scripts/ as a module.
__pycache__/
*.pyc
